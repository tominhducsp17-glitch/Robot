<?xml version="1.0"?>
<sdf version="1.9">
  <world name="phase1_baseline">
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.8 0.82 0.85 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 5 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="work_table">
      <static>true</static>
      <pose>0.55 0 0.375 0 0 0</pose>
      <link name="table_link">
        <collision name="top_collision"><geometry><box><size>0.9 1.0 0.75</size></box></geometry></collision>
        <visual name="top_visual">
          <geometry><box><size>0.9 1.0 0.75</size></box></geometry>
          <material><ambient>0.35 0.25 0.18 1</ambient><diffuse>0.55 0.38 0.24 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Nominal cylindrical part: 36 mm diameter, 120 mm long. -->
    <model name="peg">
      <pose>0.38 0.20 0.812 0 0 0</pose>
      <link name="peg_link">
        <inertial>
          <mass>0.08</mass>
          <inertia><ixx>0.000102</ixx><iyy>0.000102</iyy><izz>0.000013</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.018</radius><length>0.12</length></cylinder></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.018</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.1 0.35 0.8 1</ambient><diffuse>0.1 0.35 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Four walls form a 50 mm square opening: deliberately large Phase 1 clearance. -->
    <model name="fixture">
      <static>true</static>
      <pose>0.58 -0.20 0.80 0 0 0</pose>
      <link name="fixture_link">
        <collision name="wall_x_pos"><pose>0.035 0 0.05 0 0 0</pose><geometry><box><size>0.02 0.09 0.10</size></box></geometry></collision>
        <collision name="wall_x_neg"><pose>-0.035 0 0.05 0 0 0</pose><geometry><box><size>0.02 0.09 0.10</size></box></geometry></collision>
        <collision name="wall_y_pos"><pose>0 0.035 0.05 0 0 0</pose><geometry><box><size>0.05 0.02 0.10</size></box></geometry></collision>
        <collision name="wall_y_neg"><pose>0 -0.035 0.05 0 0 0</pose><geometry><box><size>0.05 0.02 0.10</size></box></geometry></collision>
        <visual name="wall_x_pos_visual"><pose>0.035 0 0.05 0 0 0</pose><geometry><box><size>0.02 0.09 0.10</size></box></geometry><material><ambient>0.75 0.25 0.1 1</ambient><diffuse>0.75 0.25 0.1 1</diffuse></material></visual>
        <visual name="wall_x_neg_visual"><pose>-0.035 0 0.05 0 0 0</pose><geometry><box><size>0.02 0.09 0.10</size></box></geometry><material><ambient>0.75 0.25 0.1 1</ambient><diffuse>0.75 0.25 0.1 1</diffuse></material></visual>
        <visual name="wall_y_pos_visual"><pose>0 0.035 0.05 0 0 0</pose><geometry><box><size>0.05 0.02 0.10</size></box></geometry><material><ambient>0.75 0.25 0.1 1</ambient><diffuse>0.75 0.25 0.1 1</diffuse></material></visual>
        <visual name="wall_y_neg_visual"><pose>0 -0.035 0.05 0 0 0</pose><geometry><box><size>0.05 0.02 0.10</size></box></geometry><material><ambient>0.75 0.25 0.1 1</ambient><diffuse>0.75 0.25 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="overhead_camera">
      <static>true</static>
      <pose>0.50 0 1.85 0 1.570796 0</pose>
      <link name="camera_link">
        <sensor name="rgbd_camera" type="rgbd_camera">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <topic>/phase1/camera</topic>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>5.0</far></clip>
          </camera>
        </sensor>
        <visual name="housing">
          <geometry><box><size>0.08 0.08 0.05</size></box></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
